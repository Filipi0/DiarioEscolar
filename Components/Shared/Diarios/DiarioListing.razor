@using DiarioEscolar.Models
@using DiarioEscolar.Dtos

<div class="diarios-section">
    <div class="section-header">
        <div class="educator-info">
            <div class="educator-name">@EducatorName</div>
            <button class="back-button" @onclick="OnBack">← Voltar</button>
        </div>
    </div>

    <div class="section-title">
        <div class="icon">
            <img src="/book.png" alt="Ícone de diários" class="icon-img" />
        </div>
        <h2>Diários</h2>
    </div>

    @if (DiariosComTurma.Any())
    {
        <div class="diarios-grid">
            @foreach (var diario in DiariosComTurma)
            {
                <div class="diario-card" @onclick="() => OnSelectDiario.InvokeAsync(diario)">
                    <div class="diario-header">
                        <div class="diario-title">@diario.TurmaNome</div>
                        <div class="diario-badge">@diario.TurmaSerie</div>
                    </div>
                    <div class="diario-subject">@diario.Disciplina</div>
                    <div class="diario-info">
                        <div class="student-count">
                            👥 @diario.NumeroEstudantes estudantes
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📖</div>
            <h3>Nenhum diário encontrado</h3>
            <p>Este educador ainda não possui diários cadastrados.</p>
        </div>
    }
</div>

@code {
    [Parameter] public string EducatorName { get; set; } = string.Empty;
    [Parameter] public List<DiarioComTurmaDto> DiariosComTurma { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<DiarioComTurmaDto> OnSelectDiario { get; set; }
}