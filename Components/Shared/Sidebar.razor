@using DiarioEscolar.Models

<div class="sidebar">
    <!-- Header -->
    <div class="sidebar-header">
        <button class="logo-button" @onclick="() => OnBackToLanding.InvokeAsync()">
            <div class="logo-icon">
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 14l9-5-9-5-9 5 9 5z"/>
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
            </div>
            <div class="logo-text">
                <h1 class="logo-title">Diário Escolar</h1>
                <p class="logo-subtitle">Sistema de Gestão</p>
            </div>
        </button>
    </div>

    <!-- Menu -->
    <nav class="sidebar-nav">
        <ul class="menu-list">
            @foreach (var item in menuItems)
            {
                <li class="menu-item">
                    <button class="menu-button @(CurrentView == item.View ? "active" : "")" 
                            @onclick="() => OnViewChange.InvokeAsync(item.View)">
                        <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            @((MarkupString)item.IconPath)
                        </svg>
                        <span>@item.Label</span>
                    </button>
                </li>
            }
        </ul>
    </nav>

    <!-- Footer -->
    <div class="sidebar-footer">
        <div class="version-info">
            <p>v1.0.0 - Sistema Protótipo</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public ViewType CurrentView { get; set; }
    [Parameter] public EventCallback<ViewType> OnViewChange { get; set; }
    [Parameter] public EventCallback OnBackToLanding { get; set; }

    private readonly List<MenuItem> menuItems = new()
    {
        new MenuItem { View = ViewType.Escola, Label = "Escola", IconPath = "<path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"></path><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"></path>" },
        new MenuItem { View = ViewType.Turmas, Label = "Turmas", IconPath = "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"m22 21-3-3m0 0a5.5 5.5 0 1 1-7.78-7.78 5.5 5.5 0 0 1 7.78 7.78Z\"></path>" },
        new MenuItem { View = ViewType.Diario, Label = "Diário", IconPath = "<path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20\"></path>" }
    };

    private class MenuItem
    {
        public ViewType View { get; set; }
        public string Label { get; set; } = string.Empty;
        public string IconPath { get; set; } = string.Empty;
    }
}
