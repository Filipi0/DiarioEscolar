@using DiarioEscolar.Models
@using DiarioEscolar.Services
@inject TurmasService TurmasService

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">@(TurmaToEdit != null ? "Editar Turma" : "Nova Turma")</h2>
                <button class="close-button" @onclick="CloseModal">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m18 6-12 12M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            
            <div class="modal-body">
                <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                    <div class="form-group">
                        <label>Nome da Turma</label>
                        <input @bind="nomeTurma" type="text" placeholder="Ex: Turma A" required />
                    </div>
                    <div class="form-group">
                        <label>Série</label>
                        <select @bind="serieTurma" required>
                            <option value="">Selecione a série</option>
                            <option value="1º Ano">1º Ano</option>
                            <option value="2º Ano">2º Ano</option>
                            <option value="3º Ano">3º Ano</option>
                            <option value="4º Ano">4º Ano</option>
                            <option value="5º Ano">5º Ano</option>
                            <option value="6º Ano">6º Ano</option>
                            <option value="7º Ano">7º Ano</option>
                            <option value="8º Ano">8º Ano</option>
                            <option value="9º Ano">9º Ano</option>
                        </select>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="secondary-button" @onclick="CloseModal">Cancelar</button>
                        <button type="submit" class="primary-button">@(TurmaToEdit != null ? "Salvar Alterações" : "Criar Turma")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnTurmaAdded { get; set; }
    [Parameter] public Turma? TurmaToEdit { get; set; }

    private string nomeTurma = string.Empty;
    private string serieTurma = string.Empty;

    protected override void OnParametersSet()
    {
        if (TurmaToEdit != null)
        {
            nomeTurma = TurmaToEdit.Nome;
            serieTurma = TurmaToEdit.Serie;
        }
        else
        {
            nomeTurma = string.Empty;
            serieTurma = string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(nomeTurma) && !string.IsNullOrWhiteSpace(serieTurma))
        {
            if (TurmaToEdit != null)
            {
                // Editando turma existente
                TurmaToEdit.Nome = nomeTurma.Trim();
                TurmaToEdit.Serie = serieTurma.Trim();
                await TurmasService.UpdateTurmaAsync(TurmaToEdit);
            }
            else
            {
                // Criando nova turma
                var novaTurma = new Turma
                {
                    Nome = nomeTurma.Trim(),
                    Serie = serieTurma.Trim()
                };
                await TurmasService.AddTurmaAsync(novaTurma);
            }

            await OnTurmaAdded.InvokeAsync();
            await CloseModal();
        }
    }

    private async Task CloseModal()
    {
        // Reset form data
        nomeTurma = string.Empty;
        serieTurma = string.Empty;
        
        await OnClose.InvokeAsync();
    }
}
