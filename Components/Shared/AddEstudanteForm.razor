<form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
    <div class="form-group">
        <label>Nome do Estudante</label>
        <input @onchange="OnNomeChanged" value="@NomeEstudante" type="text" placeholder="Ex: Ana Silva" required />
    </div>
    <div class="modal-actions">
        <button type="button" class="secondary-button" @onclick="OnCancel">Cancelar</button>
        <button type="submit" class="primary-button">Adicionar</button>
    </div>
</form>

@code {
    [Parameter] public string NomeEstudante { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> NomeEstudanteChanged { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(NomeEstudante);
    }

    private async Task OnNomeChanged(ChangeEventArgs e)
    {
        NomeEstudante = e.Value?.ToString() ?? string.Empty;
        await NomeEstudanteChanged.InvokeAsync(NomeEstudante);
    }
}
