@page "/diario"
@using DiarioEscolar.Models
@using DiarioEscolar.Services
@using DiarioEscolar.Dtos
@using DiarioEscolar.Components.Shared.Diarios
@using DiarioEscolar.Components.Layout
@inject DiarioService DiarioService
@inject TurmasService TurmasService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="app-container">
    <Sidebar CurrentView="ViewType.Diario" 
             OnViewChange="HandleViewChange" 
             OnBackToLanding="HandleBackToLanding" />
    
    <div class="main-content">
        <div class="diario-container">
            <!-- Header -->
            <div class="header-section">
                <div class="header-info">
                    <h1 class="page-title">Diário Digital</h1>
                    <p class="page-subtitle">Registre conteúdos e acompanhe as aulas por educador</p>
                </div>
            </div>

    <div class="content">
        @if (!isInitialized)
        {
            <div class="loading">
                <div class="loading-spinner"></div>
                <p>Carregando...</p>
            </div>
        }
        else if (string.IsNullOrEmpty(selectedEducator))
        {
            <!-- Primeira Tela: Seleção do Educador -->
            <div class="educator-selection">
                <div class="selection-header">
                    <div class="icon">
                        <img src="/teacher.png" alt="Ícone de professor" class="icon-img" />
                    </div>
                    <h2>Selecionar o Educador</h2>
                </div>
                
                <div class="search-container">
                    <input @bind="searchTerm" @oninput="OnSearchInputChanged" 
                           placeholder="Escolha um educador" 
                           class="educator-search" />
                    <div class="search-icon">
                        <img src="/lupa.png" alt="Ícone de busca" class="search-icon-img" />
                    </div>
                </div>

                @if (filteredEducators.Any())
                {
                    <div class="educators-dropdown">
                        @foreach (var educator in filteredEducators)
                        {
                            <div class="educator-option" @onclick="() => SelectEducator(educator)">
                                <div class="educator-name">@educator</div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(searchTerm) && !filteredEducators.Any())
                {
                    <div class="no-results">
                        <div class="no-results-icon"></div>
                        <h3>Escolha um Educador</h3>
                        <p>Selecione um educador acima para visualizar seus diários e registrar aulas</p>
                    </div>
                }
            </div>
        }
        else if (selectedDiarioCompleto == null)
        {
            <DiarioListing
                EducatorName="@selectedEducator"
                DiariosComTurma="educatorDiariosCompletos"
                OnBack="ClearSelection"
                OnSelectDiario="SelectDiario" />
        }
        else
        {
            <DiarioDetail
                SelectedEducator="@selectedEducator"
                DiarioCompleto="selectedDiarioCompleto"
                OnBackToDiarios="() => selectedDiarioCompleto = null"
                OnBackToEducators="ClearSelection"
                OnSaveRecord="SaveRecord"
                OnAddStudent="HandleAddStudent"
                OnEditStudent="HandleEditStudent"
                OnDeleteStudent="HandleDeleteStudent" />
        }
    </div>
</div>

<!-- Modal de Confirmação de Salvamento -->
@if (showSaveConfirmation)
{
    <div class="save-confirmation-overlay">
        <div class="save-confirmation-modal">
            <div class="confirmation-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 12l2 2 4-4"></path>
                    <circle cx="12" cy="12" r="10"></circle>
                </svg>
            </div>
            <h3>Registro Salvo!</h3>
            <p>O conteúdo da aula foi salvo com sucesso.</p>
        </div>
    </div>
}

@code {
    private List<Turma> turmas = new();
    private List<string> allEducators = new();
    private List<string> filteredEducators = new();
    private List<DiarioComTurmaDto> educatorDiariosCompletos = new();
    
    private string searchTerm = "";
    private string selectedEducator = "";
    private DiarioComTurmaDto? selectedDiarioCompleto = null;
    
    private bool isInitialized = false;
    private bool showSaveConfirmation = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            await LoadData();
            isInitialized = true;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        turmas = await TurmasService.GetTurmasAsync();
        var (educadores, _) = await DiarioService.GetAllDiariosWithEducatorsAsync();
        allEducators = educadores;
    }

    private void OnSearchInputChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FilterEducators();
    }

    private async void FilterEducators()
    {
        filteredEducators = await DiarioService.FilterEducatorsAsync(searchTerm);
        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredEducators = filteredEducators.Take(5).ToList();
        }
        StateHasChanged();
    }

    private void SelectEducator(string educator)
    {
        selectedEducator = educator;
        searchTerm = educator;
        filteredEducators = new List<string>();
        LoadEducatorDiarios();
    }

    private async void LoadEducatorDiarios()
    {
        educatorDiariosCompletos = await DiarioService.GetDiariosComTurmaCompletosAsync(selectedEducator);
        StateHasChanged();
    }

    private void SelectDiario(DiarioComTurmaDto diarioDto)
    {
        selectedDiarioCompleto = diarioDto;
    }
    
    private void ClearSelection()
    {
        selectedEducator = "";
        selectedDiarioCompleto = null;
        searchTerm = "";
        filteredEducators.Clear();
        educatorDiariosCompletos.Clear();
    }

    private async Task SaveRecord((DiarioDetail.DiaryRecord record, DateTime date) data)
    {
        if (selectedDiarioCompleto == null) return;
        
        try
        {
            var recordDto = new DiaryRecordDto
            {
                Date = data.date,
                Content = data.record.Content,
                Observations = data.record.Observations
            };

            await DiarioService.SaveDiarioRecordAsync(selectedDiarioCompleto.Id, recordDto);
            
            // Atualizar o registro localmente
            var recordData = $"{data.record.Content}|{data.record.Observations}";
            selectedDiarioCompleto.Registros[data.date.Date] = recordData;
            
            showSaveConfirmation = true;
            StateHasChanged();
            
            // Esconder o modal após 2 segundos
            await Task.Delay(2000);
            showSaveConfirmation = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar registro: {ex.Message}");
        }
    }

    // Métodos para gerenciamento de estudantes no diário
    private async Task HandleAddStudent((string StudentName, string TurmaId) data)
    {
        if (selectedDiarioCompleto != null)
        {
            await DiarioService.AddEstudanteToTurmaAsync(selectedDiarioCompleto.TurmaId, data.StudentName);
            // Recarregar dados da turma específica
            await RefreshDiarioData(selectedDiarioCompleto.TurmaId);
            StateHasChanged();
        }
    }
    
    private async Task HandleEditStudent((string StudentId, string StudentName) data)
    {
        if (selectedDiarioCompleto != null)
        {
            await DiarioService.UpdateEstudanteInTurmaAsync(selectedDiarioCompleto.TurmaId, data.StudentId, data.StudentName);
            // Recarregar dados da turma específica
            await RefreshDiarioData(selectedDiarioCompleto.TurmaId);
            StateHasChanged();
        }
    }
    
    private async Task HandleDeleteStudent((string StudentId, string StudentName) data)
    {
        if (selectedDiarioCompleto != null)
        {
            await DiarioService.DeleteEstudanteFromTurmaAsync(selectedDiarioCompleto.TurmaId, data.StudentId);
            // Recarregar dados da turma específica
            await RefreshDiarioData(selectedDiarioCompleto.TurmaId);
            StateHasChanged();
        }
    }
    
    // Método auxiliar para recarregar dados da turma após mudanças
    private async Task RefreshDiarioData(string turmaId)
    {
        turmas = await TurmasService.GetTurmasAsync();
        var turma = turmas.FirstOrDefault(t => t.Id == turmaId);
        if (turma != null && selectedDiarioCompleto != null)
        {
            selectedDiarioCompleto.TurmaStudents = turma.Estudantes?.OrderBy(e => e.Nome).ToList() ?? new List<Estudante>();
            selectedDiarioCompleto.NumeroEstudantes = turma.Estudantes?.Count ?? 0;
        }
    }

    private void HandleViewChange(ViewType view)
    {
        switch (view)
        {
            case ViewType.Landing:
                Navigation?.NavigateTo("/");
                break;
            case ViewType.Escola:
                Navigation?.NavigateTo("/dashboard");
                break;
            case ViewType.Turmas:
                Navigation?.NavigateTo("/turmas");
                break;
            case ViewType.Diario:
                break;
        }
    }

    private void HandleBackToLanding()
    {
        Navigation?.NavigateTo("/");
    }
}
        </div>
    </div>