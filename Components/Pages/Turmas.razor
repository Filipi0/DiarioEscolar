@page "/turmas"
@using DiarioEscolar.Models
@using DiarioEscolar.Services
@using DiarioEscolar.Components.Shared
@using DiarioEscolar.Dtos
@inject LocalStorageService LocalStorage
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="app-container">
    <Sidebar CurrentView="ViewType.Turmas" 
             OnViewChange="HandleViewChange" 
             OnBackToLanding="HandleBackToLanding" />
    
    <div class="main-content">
        @if (selectedTurma != null)
        {
            <!-- Detalhes da Turma -->
            <div class="turma-detail">
                <!-- Header -->
                <div class="header-section">
                    <button class="back-button" @onclick="HandleBack">
                        @Icons.ArrowLeft
                    </button>
                    <div class="header-info">
                        <h1 class="page-title">@selectedTurma.Nome</h1>
                        <p class="page-subtitle">@selectedTurma.Serie • @selectedTurma.Estudantes.Count estudantes</p>
                    </div>
                </div>

                <div class="detail-grid">
                    <!-- Horários -->
                    <SectionCard Title="Horários" 
                                 Color="blue" 
                                 AddButtonText="Aula"
                                 IconSvg="@Icons.Clock"
                                 OnAdd="() => ShowModal(ModalType.Horario)">
                        @if (selectedTurma.Horarios.Any())
                        {
                            @foreach (var horario in selectedTurma.Horarios)
                            {
                                <div class="item-card">
                                    <div class="item-header">
                                        <span class="day-badge">@diasSemana[horario.DiaSemana]</span>
                                        <span class="time-text">@horario.HoraInicio - @horario.HoraFim</span>
                                    </div>
                                    <p class="item-title">@horario.Disciplina</p>
                                    <p class="item-subtitle">@horario.Professor</p>
                                </div>
                            }
                        }
                        else
                        {
                            <EmptyState IconSvg="@Icons.Clock" Message="Nenhum horário cadastrado" />
                        }
                    </SectionCard>

                    <!-- Diários -->
                    <SectionCard Title="Diários" 
                                 Color="emerald" 
                                 AddButtonText="Diário"
                                 IconSvg="@Icons.Book"
                                 OnAdd="() => ShowModal(ModalType.Diario)">
                        @if (selectedTurma.Diarios.Any())
                        {
                            @foreach (var diario in selectedTurma.Diarios)
                            {
                                <div class="item-card">
                                    <p class="item-title">@diario.Disciplina</p>
                                    <p class="item-subtitle">@diario.ProfessorNome</p>
                                </div>
                            }
                        }
                        else
                        {
                            <EmptyState IconSvg="@Icons.Book" Message="Nenhum diário cadastrado" />
                        }
                    </SectionCard>

                    <!-- Estudantes -->
                    <SectionCard Title="Estudantes" 
                                 Color="purple" 
                                 AddButtonText="Aluno"
                                 IconSvg="@Icons.Users"
                                 IsScrollable="true"
                                 OnAdd="() => ShowModal(ModalType.Estudante)">
                        @if (selectedTurma.Estudantes.Any())
                        {
                            @for (int i = 0; i < selectedTurma.Estudantes.Count; i++)
                            {
                                var estudante = selectedTurma.Estudantes[i];
                                <StudentCard Index="@(i + 1)" Name="@estudante.Nome" />
                            }
                        }
                        else
                        {
                            <EmptyState IconSvg="@Icons.Users" Message="Nenhum estudante cadastrado" />
                        }
                    </SectionCard>
                </div>
            </div>
        }
        else
        {
            <!-- Lista de Turmas -->
            <div class="turmas-listing">
                <!-- Header -->
                <div class="header-section">
                    <div class="header-info">
                        <h1 class="page-title">Gestão de Turmas</h1>
                        <p class="page-subtitle">Organize e gerencie todas as turmas da escola</p>
                    </div>
                    <button class="primary-button" @onclick="ShowAddTurmaModal">
                        @Icons.Plus
                        <span>Nova Turma</span>
                    </button>
                </div>

                <!-- Turmas Table -->
                <div class="table-container">
                    @if (turmas.Any())
                    {
                        <div class="table-header">
                            <div class="table-row">
                                <div class="table-cell">Turma</div>
                                <div class="table-cell">Série</div>
                                <div class="table-cell">Estudantes</div>
                                <div class="table-cell">Ações</div>
                            </div>
                        </div>
                        <div class="table-body">
                            @foreach (var turma in turmas)
                            {
                                <div class="table-row">
                                    <div class="table-cell">
                                        <div class="turma-info">
                                            <div class="turma-icon">
                                                @Icons.School
                                            </div>
                                            <p class="turma-name">@turma.Nome</p>
                                        </div>
                                    </div>
                                    <div class="table-cell">
                                        <span class="serie-badge">@turma.Serie</span>
                                    </div>
                                    <div class="table-cell">
                                        <div class="student-count">
                                            @Icons.User
                                            <span>@turma.Estudantes.Count</span>
                                        </div>
                                    </div>
                                    <div class="table-cell">
                                        <button class="view-button" @onclick="() => SelectTurma(turma.Id)">
                                            @Icons.Eye
                                            <span>Ver Detalhes</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-table">
                            @Icons.School
                            <h3>Nenhuma turma cadastrada</h3>
                            <p>Comece criando sua primeira turma para organizar os estudantes</p>
                            <button class="primary-button" @onclick="ShowAddTurmaModal">
                                @Icons.Plus
                                <span>Criar Primeira Turma</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Turma Modal Component -->
<AddTurmaModal IsVisible="showAddTurmaModal" 
               OnClose="CloseAddTurmaModal" 
               OnTurmaAdded="HandleTurmaAdded" />

<!-- Modal Forms -->
@if (showModal)
{
    <ModalForm IsVisible="showModal" Title="@GetModalTitle()" OnClose="CloseModal">
        @if (currentModal == ModalType.Horario)
        {
            <AddHorarioForm Horario="novoHorario"
                            DiaSemana="diasSemana"
                            ProfessoresSugestoes="professoresSugestoes"
                            ProfessoresDisciplinas="professoresDisciplinas"
                            OnSave="HandleAddHorario"
                            OnCancel="CloseModal"
                            OnProfessorInputChange="OnProfessorInput"
                            OnProfessorFocusEvent="OnProfessorFocus"
                            OnProfessorBlurEvent="OnProfessorBlur"
                            OnProfessorSelect="SelectProfessor" />
        }
        else if (currentModal == ModalType.Diario)
        {
            <AddDiarioForm Diario="novoDiario"
                           OnSave="HandleAddDiario"
                           OnCancel="CloseModal" />
        }
        else if (currentModal == ModalType.Estudante)
        {
            <AddEstudanteForm @bind-NomeEstudante="nomeEstudante"
                              OnSave="HandleAddEstudante"
                              OnCancel="CloseModal" />
        }
    </ModalForm>
}

@code {
    private List<Turma> turmas = new();
    private Turma? selectedTurma = null;
    private bool showModal = false;
    private ModalType currentModal = ModalType.Horario;
    private bool showAddTurmaModal = false;
    
    // Form data
    private string nomeEstudante = string.Empty;
    private NovoHorarioDto novoHorario = new();
    private NovoDiarioDto novoDiario = new();
    
    // Professor autocomplete
    private List<string> professoresSugestoes = new();
    private List<string> professoresOriginais = new();
    private Dictionary<string, string> professoresDisciplinas = new();

    private readonly string[] diasSemana = { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };

    private enum ModalType
    {
        Horario,
        Diario,
        Estudante
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTurmas();
            StateHasChanged();
        }
    }

    private async Task LoadTurmas()
    {
        try
        {
            turmas = await LocalStorage.GetTurmasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar turmas: {ex.Message}");
        }
    }

    private void HandleViewChange(ViewType newView)
    {
        if (newView == ViewType.Escola)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else if (newView == ViewType.Diario)
        {
            // Navegar para página de diários quando implementar
        }
    }

    private void HandleBackToLanding()
    {
        Navigation.NavigateTo("/");
    }

    private void SelectTurma(string turmaId)
    {
        selectedTurma = turmas.FirstOrDefault(t => t.Id == turmaId);
    }

    private void HandleBack()
    {
        selectedTurma = null;
    }

    private void ShowModal(ModalType modalType)
    {
        currentModal = modalType;
        showModal = true;
        
        // Reset form data
        nomeEstudante = string.Empty;
        novoHorario = new NovoHorarioDto();
        novoDiario = new NovoDiarioDto();
        
        // Carregar sugestões de professores se for modal de horário
        if (modalType == ModalType.Horario)
        {
            LoadProfessoresSugestoes();
        }
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void ShowAddTurmaModal()
    {
        showAddTurmaModal = true;
    }

    private void CloseAddTurmaModal()
    {
        showAddTurmaModal = false;
    }

    private async Task HandleTurmaAdded()
    {
        await LoadTurmas();
    }

    private string GetModalTitle()
    {
        return currentModal switch
        {
            ModalType.Horario => "Nova Aula",
            ModalType.Diario => "Novo Diário",
            ModalType.Estudante => "Novo Estudante",
            _ => string.Empty
        };
    }

    // Método centralizado para atualização
    private async Task UpdateSelectedTurma()
    {
        if (selectedTurma != null)
        {
            await LocalStorage.UpdateTurmaAsync(selectedTurma);
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
            CloseModal();
        }
    }

    private async Task HandleAddHorario(NovoHorarioDto horario)
    {
        if (selectedTurma != null && !string.IsNullOrEmpty(horario.DiaSemana))
        {
            var novoHorarioObj = new Horario
            {
                DiaSemana = int.Parse(horario.DiaSemana),
                HoraInicio = horario.HoraInicio,
                HoraFim = horario.HoraFim,
                Disciplina = horario.Disciplina,
                Professor = horario.Professor,
                TurmaId = selectedTurma.Id
            };

            selectedTurma.Horarios.Add(novoHorarioObj);
            await UpdateSelectedTurma();
        }
    }

    private async Task HandleAddDiario(NovoDiarioDto diario)
    {
        if (selectedTurma != null)
        {
            var novoDiarioObj = new Diario
            {
                ProfessorNome = diario.ProfessorNome,
                Disciplina = diario.Disciplina,
                TurmaId = selectedTurma.Id
            };

            selectedTurma.Diarios.Add(novoDiarioObj);
            await UpdateSelectedTurma();
        }
    }

    private async Task HandleAddEstudante(string nome)
    {
        if (selectedTurma != null && !string.IsNullOrWhiteSpace(nome))
        {
            var estudante = new Estudante
            {
                Nome = nome.Trim(),
                TurmaId = selectedTurma.Id
            };

            selectedTurma.Estudantes.Add(estudante);
            selectedTurma.Estudantes = selectedTurma.Estudantes.OrderBy(e => e.Nome).ToList();
            
            await UpdateSelectedTurma();
        }
    }

    // Professor autocomplete methods
    private void LoadProfessoresSugestoes()
    {
        professoresSugestoes.Clear();
        professoresDisciplinas.Clear();
        
        var professoresUnicos = new HashSet<string>();
        
        foreach (var turma in turmas)
        {
            foreach (var horario in turma.Horarios)
            {
                if (!string.IsNullOrWhiteSpace(horario.Professor))
                {
                    professoresUnicos.Add(horario.Professor);
                    if (!professoresDisciplinas.ContainsKey(horario.Professor))
                    {
                        professoresDisciplinas[horario.Professor] = horario.Disciplina;
                    }
                }
            }
            
            foreach (var diario in turma.Diarios)
            {
                if (!string.IsNullOrWhiteSpace(diario.ProfessorNome))
                {
                    professoresUnicos.Add(diario.ProfessorNome);
                    if (!professoresDisciplinas.ContainsKey(diario.ProfessorNome))
                    {
                        professoresDisciplinas[diario.ProfessorNome] = diario.Disciplina;
                    }
                }
            }
        }
        
        professoresSugestoes = professoresUnicos.OrderBy(p => p).ToList();
        professoresOriginais = new List<string>(professoresSugestoes);
    }

    private void OnProfessorInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? string.Empty;
        novoHorario.Professor = input;
        
        if (string.IsNullOrWhiteSpace(input))
        {
            professoresSugestoes = new List<string>(professoresOriginais);
        }
        else
        {
            professoresSugestoes = professoresOriginais
                .Where(p => p.Contains(input, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        
        StateHasChanged();
    }

    private void OnProfessorFocus()
    {
        LoadProfessoresSugestoes();
        professoresSugestoes = new List<string>(professoresOriginais);
        StateHasChanged();
    }

    private async Task OnProfessorBlur()
    {
        await Task.Delay(150);
        StateHasChanged();
    }

    private void SelectProfessor(string professor)
    {
        novoHorario.Professor = professor;
        
        if (professoresDisciplinas.ContainsKey(professor))
        {
            novoHorario.Disciplina = professoresDisciplinas[professor];
        }
        
        StateHasChanged();
    }
}
