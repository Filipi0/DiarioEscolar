@page "/turmas"
@using DiarioEscolar.Models
@using DiarioEscolar.Services
@using DiarioEscolar.Components.Shared
@using DiarioEscolar.Components.Shared.Turmas
@using DiarioEscolar.Dtos
@using DiarioEscolar.Components.Layout
@inject TurmasService TurmasService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="app-container">
    <Sidebar CurrentView="ViewType.Turmas" 
             OnViewChange="HandleViewChange" 
             OnBackToLanding="HandleBackToLanding" />
    
    <div class="main-content">
        @if (selectedTurma != null)
        {
            <TurmaDetail SelectedTurma="selectedTurma"
                        DiaSemana="diasSemana"
                        OnBack="HandleBack"
                        OnShowModal="ShowModalHandler"
                        OnEditEstudante="EditEstudante"
                        OnDeleteEstudante="DeleteEstudante"
                        OnEditHorario="EditHorario"
                        OnDeleteHorario="DeleteHorario"
                        OnEditDiario="EditDiario"
                        OnDeleteDiario="DeleteDiario" />
        }
        else
        {
            <TurmasListing Turmas="turmas"
                          OnShowAddModal="ShowAddTurmaModal"
                          OnSelectTurma="SelectTurma"
                          OnEditTurma="EditTurma"
                          OnDeleteTurma="ShowDeleteTurmaConfirmation" />
        }
    </div>
</div>

<!-- Add Turma Modal Component -->
<AddTurmaModal IsVisible="showAddTurmaModal" 
               TurmaToEdit="turmaToEdit"
               OnClose="CloseAddTurmaModal" 
               OnTurmaAdded="HandleTurmaAdded" />

<!-- Modal Forms -->
@if (showModal)
{
    <ModalForm IsVisible="showModal" Title="@GetModalTitle()" OnClose="CloseModal">
        @if (currentModal == TurmaDetail.ModalType.Horario)
        {
            <AddHorarioForm Horario="novoHorario"
                            DiaSemana="diasSemana"
                            ProfessoresSugestoes="professoresSugestoes"
                            ProfessoresDisciplinas="professoresDisciplinas"
                            OnSave="HandleAddHorario"
                            OnCancel="CloseModal"
                            OnProfessorInputChange="OnProfessorInput"
                            OnProfessorFocusEvent="OnProfessorFocus"
                            OnProfessorBlurEvent="OnProfessorBlur"
                            OnProfessorSelect="SelectProfessor" />
        }
        else if (currentModal == TurmaDetail.ModalType.Diario)
        {
            <AddDiarioForm Diario="novoDiario"
                           OnSave="HandleAddDiario"
                           OnCancel="CloseModal" />
        }
        else if (currentModal == TurmaDetail.ModalType.Estudante)
        {
            <AddEstudanteForm @bind-Value="nomeEstudante"
                              OnSave="HandleAddEstudante"
                              OnCancel="CloseModal" />
        }
    </ModalForm>
}

<!-- Modal de Confirmação de Exclusão -->
<ConfirmationModal IsVisible="showDeleteConfirmation"
                   Title="Confirmar Exclusão"
                   Message="@GetDeleteMessage()"
                   WarningText="Esta ação não pode ser desfeita."
                   CancelText="Cancelar"
                   ConfirmText="Excluir"
                   ConfirmButtonClass="danger-button"
                   IconSvg="@Icons.Trash"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CloseDeleteConfirmation" />

@code {
    private List<Turma> turmas = new();
    private Turma? selectedTurma = null;
    private bool showModal = false;
    private TurmaDetail.ModalType currentModal = TurmaDetail.ModalType.Horario;
    private bool showAddTurmaModal = false;
    private bool showDeleteConfirmation = false;
    private string deleteItemType = string.Empty;
    private string deleteItemId = string.Empty;
    private string deleteItemName = string.Empty;
    private Turma? turmaToEdit = null;
    private string estudanteEditandoId = string.Empty;
    private string horarioEditandoId = string.Empty;
    private string diarioEditandoId = string.Empty;
    
    // Form data
    private string nomeEstudante = string.Empty;
    private NovoHorarioDto novoHorario = new();
    private NovoDiarioDto novoDiario = new();
    
    // Professor autocomplete
    private List<string> professoresSugestoes = new();
    private List<string> professoresOriginais = new();
    private Dictionary<string, string> professoresDisciplinas = new();

    private readonly string[] diasSemana = { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTurmas();
            StateHasChanged();
        }
    }

    private async Task LoadTurmas()
    {
        try
        {
            turmas = await TurmasService.GetTurmasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar turmas: {ex.Message}");
        }
    }

    private void HandleViewChange(ViewType newView)
    {
        if (newView == ViewType.Escola)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else if (newView == ViewType.Diario)
        {
            Navigation.NavigateTo("/diario");
        }
    }

    private void HandleBackToLanding()
    {
        Navigation.NavigateTo("/");
    }

    private void SelectTurma(string turmaId)
    {
        selectedTurma = turmas.FirstOrDefault(t => t.Id == turmaId);
    }

    private void HandleBack()
    {
        selectedTurma = null;
    }

    // Métodos para componentes
    private void ShowModalHandler(TurmaDetail.ModalType modalType)
    {
        currentModal = modalType;
        showModal = true;
        
        // Reset form data
        nomeEstudante = string.Empty;
        novoHorario = new NovoHorarioDto();
        novoDiario = new NovoDiarioDto();
        
        // Carregar sugestões de professores se for modal de horário
        if (modalType == TurmaDetail.ModalType.Horario)
        {
            _ = LoadProfessoresSugestoes();
        }
    }

    private void ShowDeleteTurmaConfirmation((string Id, string Nome) turmaInfo)
    {
        deleteItemType = "turma";
        deleteItemId = turmaInfo.Id;
        deleteItemName = turmaInfo.Nome;
        showDeleteConfirmation = true;
    }

    private void DeleteHorario((string Id, string Nome) horarioInfo)
    {
        deleteItemType = "horário";
        deleteItemId = horarioInfo.Id;
        deleteItemName = horarioInfo.Nome;
        showDeleteConfirmation = true;
    }

    private void DeleteDiario((string Id, string Nome) diarioInfo)
    {
        deleteItemType = "diário";
        deleteItemId = diarioInfo.Id;
        deleteItemName = diarioInfo.Nome;
        showDeleteConfirmation = true;
    }

    private string GetDeleteMessage()
    {
        return $"Tem certeza que deseja excluir {deleteItemType} \"{deleteItemName}\"?";
    }

    private void CloseModal()
    {
        showModal = false;
        estudanteEditandoId = string.Empty;
        horarioEditandoId = string.Empty;
        diarioEditandoId = string.Empty;
    }

    private void ShowAddTurmaModal()
    {
        showAddTurmaModal = true;
    }

    private void CloseAddTurmaModal()
    {
        showAddTurmaModal = false;
        turmaToEdit = null;
    }

    private async Task HandleTurmaAdded()
    {
        await LoadTurmas();
    }

    private string GetModalTitle()
    {
        return currentModal switch
        {
            TurmaDetail.ModalType.Horario => "Nova Aula",
            TurmaDetail.ModalType.Diario => "Novo Diário",
            TurmaDetail.ModalType.Estudante => "Novo Estudante",
            _ => string.Empty
        };
    }

    // Método centralizado para atualização
    private async Task UpdateSelectedTurma()
    {
        if (selectedTurma != null)
        {
            await TurmasService.UpdateTurmaAsync(selectedTurma);
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
            CloseModal();
        }
    }

    private async Task HandleAddHorario(NovoHorarioDto horario)
    {
        if (selectedTurma != null && !string.IsNullOrEmpty(horario.DiaSemana))
        {
            if (!string.IsNullOrEmpty(horarioEditandoId))
            {
                // Editando horário existente
                await TurmasService.UpdateHorarioAsync(selectedTurma.Id, horarioEditandoId, horario);
                horarioEditandoId = string.Empty;
            }
            else
            {
                // Adicionando novo horário
                await TurmasService.AddHorarioAsync(selectedTurma.Id, horario);
            }
            
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
            CloseModal();
        }
    }

    private async Task HandleAddDiario(NovoDiarioDto diario)
    {
        if (selectedTurma != null)
        {
            if (!string.IsNullOrEmpty(diarioEditandoId))
            {
                // Editando diário existente
                await TurmasService.UpdateDiarioAsync(selectedTurma.Id, diarioEditandoId, diario);
                diarioEditandoId = string.Empty;
            }
            else
            {
                // Adicionando novo diário
                await TurmasService.AddDiarioAsync(selectedTurma.Id, diario);
            }
            
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
            CloseModal();
        }
    }

    private async Task HandleAddEstudante(string nome)
    {
        if (selectedTurma != null && !string.IsNullOrWhiteSpace(nome))
        {
            if (!string.IsNullOrEmpty(estudanteEditandoId))
            {
                // Editando estudante existente
                await TurmasService.UpdateEstudanteAsync(selectedTurma.Id, estudanteEditandoId, nome);
                estudanteEditandoId = string.Empty;
            }
            else
            {
                // Adicionando novo estudante
                await TurmasService.AddEstudanteAsync(selectedTurma.Id, nome);
            }
            
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
            CloseModal();
        }
    }

    // Professor autocomplete methods
    private async Task LoadProfessoresSugestoes()
    {
        professoresSugestoes = await TurmasService.GetProfessoresAsync();
        professoresOriginais = new List<string>(professoresSugestoes);
        professoresDisciplinas = await TurmasService.GetProfessoresDisciplinasAsync();
    }

    private async Task OnProfessorInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? string.Empty;
        novoHorario.Professor = input;
        
        professoresSugestoes = await TurmasService.FilterProfessoresAsync(input);
        StateHasChanged();
    }

    private async Task OnProfessorFocus()
    {
        await LoadProfessoresSugestoes();
        StateHasChanged();
    }

    private async Task OnProfessorBlur()
    {
        await Task.Delay(150);
        StateHasChanged();
    }

    private void SelectProfessor(string professor)
    {
        novoHorario.Professor = professor;
        
        if (professoresDisciplinas.ContainsKey(professor))
        {
            novoHorario.Disciplina = professoresDisciplinas[professor];
        }
        
        StateHasChanged();
    }

    // Métodos para editar e excluir
    private void EditTurma(Turma turma)
    {
        turmaToEdit = turma;
        showAddTurmaModal = true;
    }
    
    private async Task ConfirmDelete()
    {
        if (deleteItemType == "turma")
        {
            await TurmasService.DeleteTurmaAsync(deleteItemId);
            await LoadTurmas();
            
            // Se a turma deletada era a selecionada, limpar seleção
            if (selectedTurma?.Id == deleteItemId)
            {
                selectedTurma = null;
            }
        }
        else if (deleteItemType == "estudante" && selectedTurma != null)
        {
            await TurmasService.DeleteEstudanteAsync(selectedTurma.Id, deleteItemId);
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
        }
        else if (deleteItemType == "horário" && selectedTurma != null)
        {
            await TurmasService.DeleteHorarioAsync(selectedTurma.Id, deleteItemId);
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
        }
        else if (deleteItemType == "diário" && selectedTurma != null)
        {
            await TurmasService.DeleteDiarioAsync(selectedTurma.Id, deleteItemId);
            await LoadTurmas();
            selectedTurma = turmas.FirstOrDefault(t => t.Id == selectedTurma.Id);
        }
        
        CloseDeleteConfirmation();
    }
    
    private void CloseDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        deleteItemType = string.Empty;
        deleteItemId = string.Empty;
        deleteItemName = string.Empty;
    }
    
    // Métodos para estudantes
    private void EditEstudante(string estudanteId)
    {
        var estudante = selectedTurma?.Estudantes.FirstOrDefault(e => e.Id == estudanteId);
        if (estudante != null)
        {
            nomeEstudante = estudante.Nome;
            estudanteEditandoId = estudanteId;
            currentModal = TurmaDetail.ModalType.Estudante;
            showModal = true;
        }
    }
    
    private void DeleteEstudante(string estudanteId)
    {
        var estudante = selectedTurma?.Estudantes.FirstOrDefault(e => e.Id == estudanteId);
        if (estudante != null)
        {
            deleteItemType = "estudante";
            deleteItemId = estudanteId;
            deleteItemName = estudante.Nome;
            showDeleteConfirmation = true;
        }
    }
    
    // Métodos para horários
    private void EditHorario(string horarioId)
    {
        var horario = selectedTurma?.Horarios.FirstOrDefault(h => h.Id == horarioId);
        if (horario != null)
        {
            novoHorario = new NovoHorarioDto
            {
                DiaSemana = horario.DiaSemana.ToString(),
                HoraInicio = horario.HoraInicio,
                HoraFim = horario.HoraFim,
                Disciplina = horario.Disciplina,
                Professor = horario.Professor
            };
            horarioEditandoId = horarioId;
            currentModal = TurmaDetail.ModalType.Horario;
            showModal = true;
            _ = LoadProfessoresSugestoes();
        }
    }
    
    // Métodos para diários
    private void EditDiario(string diarioId)
    {
        var diario = selectedTurma?.Diarios.FirstOrDefault(d => d.Id == diarioId);
        if (diario != null)
        {
            novoDiario = new NovoDiarioDto
            {
                ProfessorNome = diario.ProfessorNome,
                Disciplina = diario.Disciplina
            };
            diarioEditandoId = diarioId;
            currentModal = TurmaDetail.ModalType.Diario;
            showModal = true;
        }
    }
}
